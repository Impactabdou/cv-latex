{
  "name": "latex-cv-studio",
  "version": "1.0.0",
  "description": "Real-time, web-based LaTeX CV editor and generator",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "server": "nodemon server/index.js",
    "client": "vite",
    "build": "vite build",
    "dev": "concurrently \"nodemon server/index.js\" \"vite\"",
    "start": "node server/index.js"
  },
  "keywords": [
    "latex",
    "cv",
    "resume",
    "editor",
    "pdflatex",
    "react"
